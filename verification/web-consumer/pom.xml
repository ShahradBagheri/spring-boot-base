<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>example.standalone</groupId>
    <artifactId>base-web-consumer</artifactId>
    <version>1.0.0</version>

    <properties>
        <java.version>25</java.version>
        <base.group>io.github.shahradbagheri</base.group>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>${base.group}</groupId>
                <artifactId>spring-boot-base-bom</artifactId>
                <version>${base.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>${base.group}</groupId>
            <artifactId>base-web-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.6.3</version>
                <executions>
                    <execution>
                        <id>check-web-only-consumer</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>${base.group}:*</exclude>
                                        <exclude>org.springframework.security:*</exclude>
                                        <exclude>org.hibernate.orm:*</exclude>
                                    </excludes>
                                    <includes>
                                        <include>${base.group}:base-core</include>
                                        <include>${base.group}:base-web</include>
                                        <include>${base.group}:base-web-starter</include>
                                    </includes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>staged-base-artifacts</id>
            <activation>
                <property><name>base.repository</name></property>
            </activation>
            <repositories>
                <repository>
                    <id>publication-test</id>
                    <url>${base.repository}</url>
                    <snapshots><enabled>true</enabled></snapshots>
                </repository>
            </repositories>
        </profile>
    </profiles>
</project>

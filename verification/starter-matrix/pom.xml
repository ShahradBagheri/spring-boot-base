<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>example.standalone</groupId>
    <artifactId>base-starter-matrix</artifactId>
    <version>1.0.0</version>

    <properties>
        <java.version>25</java.version>
        <base.group>io.github.shahradbagheri</base.group>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>${base.group}</groupId>
                <artifactId>spring-boot-base-bom</artifactId>
                <version>${base.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <profile>
            <id>staged-base-artifacts</id>
            <activation>
                <property><name>base.repository</name></property>
            </activation>
            <repositories>
                <repository>
                    <id>publication-test</id>
                    <url>${base.repository}</url>
                    <snapshots><enabled>true</enabled></snapshots>
                </repository>
            </repositories>
        </profile>
        <profile>
            <id>all-starters</id>
            <dependencies>
                <dependency>
                    <groupId>${base.group}</groupId>
                    <artifactId>base-data-jpa-starter</artifactId>
                </dependency>
                <dependency>
                    <groupId>${base.group}</groupId>
                    <artifactId>base-web-starter</artifactId>
                </dependency>
                <dependency>
                    <groupId>${base.group}</groupId>
                    <artifactId>base-websocket-starter</artifactId>
                </dependency>
                <dependency>
                    <groupId>${base.group}</groupId>
                    <artifactId>base-security-starter</artifactId>
                </dependency>
                <dependency>
                    <groupId>${base.group}</groupId>
                    <artifactId>base-auth-starter</artifactId>
                </dependency>
                <dependency>
                    <groupId>${base.group}</groupId>
                    <artifactId>base-auth-oauth2-starter</artifactId>
                </dependency>
                <dependency>
                    <groupId>${base.group}</groupId>
                    <artifactId>base-auth-token-starter</artifactId>
                </dependency>
                <dependency>
                    <groupId>${base.group}</groupId>
                    <artifactId>base-auth-email-starter</artifactId>
                </dependency>
                <dependency>
                    <groupId>${base.group}</groupId>
                    <artifactId>base-mail-smtp-starter</artifactId>
                </dependency>
                <dependency>
                    <groupId>${base.group}</groupId>
                    <artifactId>base-auth-phone-starter</artifactId>
                </dependency>
                <dependency>
                    <groupId>${base.group}</groupId>
                    <artifactId>base-mcp-server-starter</artifactId>
                </dependency>
                <dependency>
                    <groupId>com.h2database</groupId>
                    <artifactId>h2</artifactId>
                    <scope>test</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>

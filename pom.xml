<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>com.notshahrad</groupId>
    <artifactId>spring-boot-base</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Spring Boot Base</name>
    <description>Reusable Spring Boot application foundation</description>

    <modules>
        <module>spring-boot-base-bom</module>
        <module>base-core</module>
        <module>base-data-jpa</module>
        <module>base-web</module>
        <module>base-websocket</module>
        <module>base-security</module>
        <module>base-auth</module>
        <module>base-auth-oauth2</module>
        <module>base-auth-token</module>
        <module>base-auth-email</module>
        <module>base-mail</module>
        <module>base-mail-smtp</module>
        <module>base-auth-phone</module>
        <module>base-sms</module>
        <module>base-mcp-server</module>
        <module>demo-app</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <spring-ai.version>2.0.3</spring-ai.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.notshahrad</groupId>
                <artifactId>base-websocket</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.notshahrad</groupId>
                <artifactId>base-mcp-server</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.notshahrad</groupId>
                <artifactId>base-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.notshahrad</groupId>
                <artifactId>base-data-jpa</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.notshahrad</groupId>
                <artifactId>base-web</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.notshahrad</groupId>
                <artifactId>base-security</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.notshahrad</groupId>
                <artifactId>base-auth</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.notshahrad</groupId>
                <artifactId>base-auth-oauth2</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.notshahrad</groupId>
                <artifactId>base-auth-token</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.notshahrad</groupId>
                <artifactId>base-auth-email</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.notshahrad</groupId>
                <artifactId>base-mail</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.notshahrad</groupId>
                <artifactId>base-mail-smtp</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.notshahrad</groupId>
                <artifactId>base-auth-phone</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.notshahrad</groupId>
                <artifactId>base-sms</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <proc>full</proc>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>

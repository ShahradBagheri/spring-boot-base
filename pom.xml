<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         child.project.url.inherit.append.path="false"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>com.notshahrad</groupId>
    <artifactId>spring-boot-base</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Spring Boot Base</name>
    <description>Reusable Spring Boot application foundation</description>
    <url>https://github.com/ShahradBagheri/spring-boot-base</url>
    <developers>
        <developer>
            <id>ShahradBagheri</id>
            <name>Shahrad Bagheri</name>
            <url>https://github.com/ShahradBagheri</url>
        </developer>
    </developers>
    <scm child.scm.connection.inherit.append.path="false"
         child.scm.developerConnection.inherit.append.path="false"
         child.scm.url.inherit.append.path="false">
        <connection>scm:git:https://github.com/ShahradBagheri/spring-boot-base.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/ShahradBagheri/spring-boot-base.git</developerConnection>
        <url>https://github.com/ShahradBagheri/spring-boot-base</url>
    </scm>

    <modules>
        <module>spring-boot-base-bom</module>
        <module>base-core</module>
        <module>base-data-jpa</module>
        <module>base-data-jpa-starter</module>
        <module>base-web</module>
        <module>base-web-starter</module>
        <module>base-websocket</module>
        <module>base-websocket-starter</module>
        <module>base-security</module>
        <module>base-security-starter</module>
        <module>base-auth</module>
        <module>base-auth-starter</module>
        <module>base-auth-oauth2</module>
        <module>base-auth-oauth2-starter</module>
        <module>base-auth-token</module>
        <module>base-auth-token-starter</module>
        <module>base-auth-email</module>
        <module>base-auth-email-starter</module>
        <module>base-mail</module>
        <module>base-mail-smtp</module>
        <module>base-mail-smtp-starter</module>
        <module>base-auth-phone</module>
        <module>base-auth-phone-starter</module>
        <module>base-sms</module>
        <module>base-mcp-server</module>
        <module>base-mcp-server-starter</module>
        <module>demo-app</module>
    </modules>

    <properties>
        <java.version>25</java.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.notshahrad</groupId>
                <artifactId>base-websocket</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.notshahrad</groupId>
                <artifactId>base-websocket-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.notshahrad</groupId>
                <artifactId>base-mcp-server</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.notshahrad</groupId>
                <artifactId>base-mcp-server-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.notshahrad</groupId>
                <artifactId>base-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.notshahrad</groupId>
                <artifactId>base-data-jpa</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.notshahrad</groupId>
                <artifactId>base-data-jpa-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.notshahrad</groupId>
                <artifactId>base-web</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.notshahrad</groupId>
                <artifactId>base-web-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.notshahrad</groupId>
                <artifactId>base-security</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.notshahrad</groupId>
                <artifactId>base-security-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.notshahrad</groupId>
                <artifactId>base-auth</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.notshahrad</groupId>
                <artifactId>base-auth-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.notshahrad</groupId>
                <artifactId>base-auth-oauth2</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.notshahrad</groupId>
                <artifactId>base-auth-oauth2-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.notshahrad</groupId>
                <artifactId>base-auth-token</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.notshahrad</groupId>
                <artifactId>base-auth-token-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.notshahrad</groupId>
                <artifactId>base-auth-email</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.notshahrad</groupId>
                <artifactId>base-auth-email-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.notshahrad</groupId>
                <artifactId>base-mail</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.notshahrad</groupId>
                <artifactId>base-mail-smtp</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.notshahrad</groupId>
                <artifactId>base-mail-smtp-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.notshahrad</groupId>
                <artifactId>base-auth-phone</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.notshahrad</groupId>
                <artifactId>base-auth-phone-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.notshahrad</groupId>
                <artifactId>base-sms</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <proc>full</proc>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <profile>
            <id>central-release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals><goal>jar-no-fork</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.12.0</version>
                        <configuration>
                            <doclint>none</doclint>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals><goal>jar</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <configuration>
                            <bestPractices>true</bestPractices>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-release-artifacts</id>
                                <phase>verify</phase>
                                <goals><goal>sign</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
